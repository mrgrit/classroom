# Google Cloud Console(https://console.cloud.google.com/apis/credentials)에서
# OAuth 2.0 클라이언트 ID(웹 애플리케이션)를 만들어 넣으세요. 패들렛과 같은 클라이언트를 써도 됩니다.
# "승인된 자바스크립트 원본"에 이 서비스 주소(예: http://localhost:3001, 터널 주소)를 추가해야 합니다.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 관리자 이메일 (쉼표로 여러 명 지정 가능). 관리자만 퀴즈를 만들고 게임을 진행할 수 있습니다.
ADMIN_EMAILS=mrgrit@ync.ac.kr

# 세션 JWT 서명 키 (아무 긴 랜덤 문자열)
JWT_SECRET=change-me-to-a-long-random-string

# 서버 포트 (패들렛은 3000, 카훗은 3001)
PORT=3001

# (선택) 이 도메인의 구글 계정만 로그인 허용. 비워두면 모든 구글 계정 허용.
# ALLOWED_HOSTED_DOMAIN=ync.ac.kr
